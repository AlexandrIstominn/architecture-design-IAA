{
  "info": {
    "name": "BotDetect API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "userId", "value": "1" }
  ],
  "item": [
    {
      "name": "Analysis",
      "item": [
        {
          "name": "POST Run analysis",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has historyId', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('historyId');",
                  "    pm.expect(json.historyId).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"socialNetwork\":\"vk\",\"accountIds\":[\"user1\",\"user2\"]}" },
            "url": "{{baseUrl}}/api/analysis"
          }
        },
        {
          "name": "GET Analyses list",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "X-User-Id", "value": "{{userId}}" } ],
            "url": "{{baseUrl}}/api/analysis"
          }
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "POST Create account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has accountId', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('accountId');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"username\":\"newman_user\",\"socialNetwork\":\"vk\"}" },
            "url": "{{baseUrl}}/api/accounts"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "GET Reports list",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "X-User-Id", "value": "{{userId}}" } ],
            "url": "{{baseUrl}}/api/reports"
          }
        }
      ]
    }
  ]
}
